# Claude – translation
ANTHROPIC_API_KEY=
# OpenAI – speech-to-text (gpt-4o-transcribe) and fallback text-to-speech
OPENAI_API_KEY=
PORT=8787
# Optional: shared secret the app must send as "x-app-key"
APP_KEY=

# --- Rate limiting (defaults shown) ---
# Number of reverse proxies in front of the server (Render = 1). 0 when exposed directly.
TRUST_PROXY=1
RATE_LIMIT_DEVICE_PER_MINUTE=40
RATE_LIMIT_IP_PER_MINUTE=120
RATE_LIMIT_DEVICE_PER_DAY=600
RATE_LIMIT_IP_PER_DAY=3000
LIVE_MAX_CONCURRENT_PER_DEVICE=1
LIVE_MAX_CONCURRENT_PER_IP=6
LIVE_MAX_CONCURRENT_TOTAL=50
LIVE_MAX_SECONDS=180
MAX_TEXT_CHARS=2000
