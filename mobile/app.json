{
  "expo": {
    "name": "Polyglot Voice",
    "slug": "polyglot-voice",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.polyglotvoice.app",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "The microphone is used to hear the speech you want translated."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0f1115",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.polyglotvoice.app",
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-audio",
        {
          "microphonePermission": "The microphone is used to hear the speech you want translated."
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "The microphone is used to hear the speech you want translated.",
          "speechRecognitionPermission": "Speech recognition turns what you say into text so it can be translated."
        }
      ]
    ],
    "backgroundColor": "#0f1115"
  }
}